{
  "extraKnownMarketplaces": {
    "helios": {
      "source": {
        "source": "github",
        "repo": "HeliosBBS/HeliosSkills"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "humanizer": {
      "source": {
        "source": "github",
        "repo": "blader/humanizer"
      }
    }
  },
  "enabledPlugins": {
    "helios@helios": true,
    "ponytail@ponytail": true,
    "humanizer@humanizer": true
  },
  "permissions": {
    "allow": [
      "Bash(git fetch *)",
      "Bash(go build *)",
      "Bash(go vet *)",
      "Bash(go test *)",
      "Bash(make check)",
      "Bash(gh run watch *)",
      "Bash(golangci-lint run *)",
      "Bash(govulncheck *)"
    ]
  }
}
